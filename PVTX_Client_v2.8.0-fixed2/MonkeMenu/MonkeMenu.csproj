<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <AssemblyName>MonkeMenu</AssemblyName>
        <RootNamespace>MonkeMenu</RootNamespace>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <DebugType>embedded</DebugType>
        <NoWarn>CS0618;CS9113</NoWarn>
    </PropertyGroup>

    <!-- Point this at your Gorilla Tag folder. Either set the GorillaTag_GamePath environment
         variable, or edit the fallback path below. -->
    <PropertyGroup>
        <GamePath>$(GorillaTag_GamePath)</GamePath>
        <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag</GamePath>
        <ManagedPath>$(GamePath)\Gorilla Tag_Data\Managed</ManagedPath>
        <BepInExCore>$(GamePath)\BepInEx\core</BepInExCore>
        <PluginsPath>$(GamePath)\BepInEx\plugins</PluginsPath>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="BepInEx">
            <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Assembly-CSharp-firstpass" Condition="Exists('$(ManagedPath)\Assembly-CSharp-firstpass.dll')">
            <HintPath>$(ManagedPath)\Assembly-CSharp-firstpass.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.InputSystem">
            <HintPath>$(ManagedPath)\Unity.InputSystem.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(ManagedPath)\Unity.TextMeshPro.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- Every UnityEngine.*Module (Core, Physics, IMGUI, InputLegacy, ...) -->
        <Reference Include="$(ManagedPath)\UnityEngine*.dll">
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- Ship UI WAVs with the build output -->
    <ItemGroup>
        <None Include="Sounds\menu_open.wav">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="Sounds\menu_click.wav">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Copy the finished DLL + UI sounds into BepInEx\plugins automatically -->
    <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(PluginsPath)')">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsPath)" />
        <MakeDir Directories="$(PluginsPath)\MonkeMenuSounds" />
        <Copy SourceFiles="Sounds\menu_open.wav;Sounds\menu_click.wav"
              DestinationFolder="$(PluginsPath)\MonkeMenuSounds"
              SkipUnchangedFiles="true"
              Condition="Exists('Sounds\menu_open.wav')" />
        <Message Text="Copied MonkeMenu.dll + UI sounds to $(PluginsPath)" Importance="high" />
    </Target>

</Project>
